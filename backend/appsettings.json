{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "Data Source=auth.db"
  },
  "Seed": {
    "AdminEmail": "admin@example.com",
    "AdminPassword": "CHANGE-ME",
    "SampleData": false
  },
  "Jwt": {
    "Key": "CHANGE-ME-dev-only-secret-key-at-least-32-characters-long!",
    "Issuer": "AuthApi",
